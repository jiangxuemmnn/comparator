<?xml version="1.0" encoding="UTF-8"?>
<!--
  应用-DB 追踪的最小可用 JMeter 测试计划（JMeter 5.5 实测通过）。

  结构（三条 JDBC Request 共用同一个连接、同一个事务）：
    1. business INSERT   —— 换成你自己的业务 SQL
       └── JSR223 PreProcessor：每个请求生成一次 REQ_ID
    2. track write       —— 调用 sp_track_write 记录本次写入
    3. commit            —— 提交整个事务

  关键点：
    * JDBC Connection Configuration 的 Autocommit 必须为 false。
    * 生成 REQ_ID 的 PreProcessor 必须挂在业务 Sampler 下面。放在线程组层级
      会在每个 Sampler 前重新执行，导致业务 SQL 与追踪写入用不同的 ID。
    * row_data 必须填写业务实际写入的值，否则校验会判为 mismatch。

  运行前指定连接信息（也可以用 GUI 打开后修改）：
    jmeter -n -t examples/jmeter_tracking.jmx -l result.jtl \
           -JKB_URL=jdbc:kingbase8://HOST:PORT/DBNAME \
           -JKB_USER=system -JKB_PASSWORD=*** -JBATCH=my_batch

  sqlserver 兼容模式：把第 2 步换成 app-db-setup 打印的普通 INSERT。
-->
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.5">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Kingbase same-transaction tracking" enabled="true">
      <stringProp name="TestPlan.comments">业务写入与追踪记录在同一事务内提交</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>
      <JDBCDataSource guiclass="TestBeanGUI" testclass="JDBCDataSource" testname="JDBC Connection Configuration" enabled="true">
        <stringProp name="dataSource">kb</stringProp>
        <stringProp name="dbUrl">${__P(KB_URL,jdbc:kingbase8://127.0.0.1:54321/kingbase)}</stringProp>
        <stringProp name="driver">com.kingbase8.Driver</stringProp>
        <stringProp name="username">${__P(KB_USER,system)}</stringProp>
        <stringProp name="password">${__P(KB_PASSWORD,CHANGE_ME)}</stringProp>
        <boolProp name="autocommit">false</boolProp>
        <boolProp name="keepAlive">true</boolProp>
        <boolProp name="preinit">false</boolProp>
        <stringProp name="poolMax">4</stringProp>
        <stringProp name="connectionAge">0</stringProp>
        <stringProp name="trimInterval">60000</stringProp>
        <stringProp name="timeout">10000</stringProp>
        <stringProp name="transactionIsolation">DEFAULT</stringProp>
        <stringProp name="checkQuery"></stringProp>
        <stringProp name="connectionProperties"></stringProp>
        <stringProp name="initQuery"></stringProp>
        <stringProp name="poolPreparedStatements"></stringProp>
      </JDBCDataSource>
      <hashTree/>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Thread Group" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">5</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">2</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration">0</stringProp>
        <stringProp name="ThreadGroup.delay">0</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </ThreadGroup>
      <hashTree>
        <!-- 第 1 步：业务写入。换成你自己的 SQL；REQ_ID 每个请求生成一次。 -->
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="business INSERT" enabled="true">
          <stringProp name="dataSource">kb</stringProp>
          <stringProp name="query">INSERT INTO public.jmeter_probe (id, v) VALUES ('${REQ_ID}', ${VAL})</stringProp>
          <stringProp name="queryType">Update Statement</stringProp>
          <stringProp name="queryTimeout">0</stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <boolProp name="autocommit">false</boolProp>
        </JDBCSampler>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="generate REQ_ID" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">vars.put(&quot;REQ_ID&quot;, java.util.UUID.randomUUID().toString()); vars.put(&quot;VAL&quot;, String.valueOf(new java.util.Random().nextInt(100000)))</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
        </hashTree>
        <!-- 第 2 步：追踪写入。row_data 必须与第 1 步实际写入的值一致。 -->
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="track write" enabled="true">
          <stringProp name="dataSource">kb</stringProp>
          <stringProp name="query">SELECT public.sp_track_write('${__P(BATCH,jmeter_test)}', 'INSERT', 'jmeter_probe', '{"id": "${REQ_ID}"}', '{"id": "${REQ_ID}", "v": ${VAL}}', '${REQ_ID}', '${REQ_ID}')</stringProp>
          <stringProp name="queryType">Select Statement</stringProp>
          <stringProp name="queryTimeout">0</stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <boolProp name="autocommit">false</boolProp>
        </JDBCSampler>
        <hashTree/>
        <!-- 第 3 步：提交整个事务（业务写入 + 追踪记录一起提交）。 -->
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="commit" enabled="true">
          <stringProp name="dataSource">kb</stringProp>
          <stringProp name="query"></stringProp>
          <stringProp name="queryType">Commit</stringProp>
          <stringProp name="queryTimeout">0</stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <boolProp name="autocommit">false</boolProp>
        </JDBCSampler>
        <hashTree/>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
