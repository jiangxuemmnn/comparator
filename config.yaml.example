# ==============================================================================
#   数据库一致性校验工具 (Database Consistency Comparator) — 配置文件
# ==============================================================================
#
#  使用方法：
#    1. 填写下方数据库节点信息
#    2. 根据需求调整 comparison / scopes / consistency / rpo 参数
#    3. 运行：python cli.py -c config.yaml <子命令>
#
#  首次使用可先生成测试数据快速体验：
#    python cli.py -c config.yaml gen-data -n node1 --accounts 5000
#    python cli.py -c config.yaml node-compare --nodes node1,node2,node3
#
# ==============================================================================

# ==============================================================================
#  一、数据库节点配置 (databases)
# ==============================================================================
#  在这里定义集群中的所有节点，每个节点是一个命名的连接信息块。
#  节点名称可以自定义（如 node1, node2, primary, standby 等），后面所有命令
#  用 -n / -a / -b / --nodes 指定节点时，填的就是这里的名称。
#
#  支持配置任意数量的节点，比如一主两备就配三个。
# ==============================================================================

databases:

  # ---- 节点1 ----
  node1:
    host: 192.168.1.101           # 数据库服务器 IP 或主机名
    port: 54321                   # Kingbase 默认 54321，PostgreSQL 默认 5432
    dbname: testdb                # 数据库名
    user: system                  # 用户名
    password: "CHANGE_ME"         # 密码（特殊字符请用引号括起来）
    connect_timeout: 10           # 连接超时秒数

  # ---- 节点2 ----
  node2:
    host: 192.168.1.102
    port: 54321
    dbname: testdb
    user: system
    password: "CHANGE_ME"
    connect_timeout: 10

  # ---- 更多节点按需添加 ----
  # node3:
  #   host: 192.168.1.103
  #   port: 54321
  #   dbname: testdb
  #   user: system
  #   password: "CHANGE_ME"
  #   connect_timeout: 10

# ==============================================================================
#  二、数据对比参数 (comparison)
# ==============================================================================

comparison:

  # ---- 默认 schema ----
  #  未配置 scopes 时生效；配了 scopes 后以 scopes 为准。
  schema: public

  # ---- 对比范围（旧字段，等价于 scopes 里的 exclude_tables）----
  tables: []
  exclude_tables:
    - _rpo_markers
    - _rpo_snapshots
    - _app_db_tracking

  # ---- checksum 分块大小 ----
  #  按主键区间切块，每块算一个 MD5。块太小则查询次数多，块太大则单块内存高。
  #  建议：百万行以下用 10000，千万行用 50000，亿级用 100000。
  chunk_size: 10000

  # ---- 并行度 ----
  #  同时对比的表数量。建议不超过数据库最大连接数。
  parallel: 4

# ==============================================================================
#  三、校验范围规则 (scopes) —— 可排除指定库 / schema / 表
# ==============================================================================
#  三层排除，从上到下依次是 database → schema → table。
#  不配置本段时，会自动用 comparison.schema + comparison.exclude_tables
#  合成一条默认规则，老配置无需改动。
#
#  规则说明：
#    - 模式支持 shell 通配符：tmp_*  *_bak  log_202?
#    - 排除优先于包含
#    - 包含列表留空 = 全部包含（再减去排除的）
#    - database 留空 = 适用于所有库
#
#  示例：test_db 里 10 张表，只想校验其中 7 张
# ==============================================================================

scopes: []

# scopes:
#   - database: test_db
#     include_schemas: [public, biz]
#     exclude_schemas: [tmp_*]
#     include_tables: []                 # 留空 = 全包含
#     exclude_tables: [tmp_*, "*_bak", _rpo_*, _app_db_*]
#
#   # 整个库跳过
#   - database: audit_db
#     exclude_tables: ["*"]
#
#   # 用通配符匹配一批库
#   - database: "archive_*"
#     exclude_tables: ["*"]

# ==============================================================================
#  四、一致性判定 (consistency) —— 决定结论能信到什么程度
# ==============================================================================
#  两个节点是两条独立连接，也就是两个不同时刻的快照。业务在持续写入时，
#  这个时间差本身就会制造差异。本段用来控制工具如何取得「可比较的窗口」，
#  并在结果里给出置信级别（deterministic / snapshot / weak / inconclusive）。
#
#  mode 可选值：
#    auto      按环境能力自动选择（默认）
#    quiesce   等业务停顿的静默窗口再校验，对增删改都有效
#    watermark 只比较水位线以下的数据，仅对 INSERT 有效
#    loose     不做窗口控制，结论为弱证据
# ==============================================================================

consistency:
  # ---- 判定方式 ----
  mode: auto

  # ---- 静默窗口秒数 ----
  #  连续 N 秒被测表无变更才开始校验。
  #  业务持续写入时可能永远等不到，此时会降级并如实说明。
  quiesce_seconds: 5

  # ---- 等待备库追平的超时秒数 ----
  lsn_timeout: 30

# ==============================================================================
#  五、RPO 检测参数 (rpo)
# ==============================================================================
#  RPO (Recovery Point Objective) = 恢复点目标，衡量故障后丢失了多少数据。
#
#  使用流程：
#    1. python cli.py -c config.yaml rpo-plant -n node1    → 得到 batch_id
#    2. [手动触发故障：kill主节点 / 断网 / 主备切换]
#    3. python cli.py -c config.yaml rpo-check -n node1 -bid <batch_id>
#
#  检测手段：
#    - 复制流探针：故障前写入的标记是否还在（判断复制流有没有送达最后的写入）
#    - 行数与主键守恒：行数是否减少、最大主键是否回退（确定的丢失证据）
#  注意：工具无法区分「业务正常删除」与「故障丢失」，
#        唯一可靠的区分手段是应用侧记录（app-db 追踪模式）。
# ==============================================================================

rpo:
  marker_schema: public

# ==============================================================================
#  六、业务负载参数 (workload)
# ==============================================================================

workload:
  concurrency: 10
  duration: 300

# ==============================================================================
#  七、定时巡检参数 (schedule)
# ==============================================================================
#  配合 JMeter 持续下发业务的场景，工具以定时巡检的方式监控数据一致性。
#
#  启动方式：
#    python cli.py -c config.yaml schedule -- node-compare --nodes node1,node2,node3
#  （--interval 不写时，取下面配置的 interval）
# ==============================================================================

schedule:
  # ---- 巡检间隔（秒）----
  #  建议：正常巡检用 300（5分钟），高频压测场景用 60（1分钟）。
  interval: 300

  # ---- 报告输出目录 ----
  #  每轮结果写成 round_*.json，另有 summary.json 汇总。
  #  单轮耗时超过间隔时会记录 overran_interval，提示两轮之间没有留白。
  report_dir: ./reports

# ==============================================================================
#  八、日志参数 (logging)
# ==============================================================================

logging:
  level: INFO
  file: ./logs/comparator.log
